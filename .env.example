# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file (it has secrets in it).

# --- Twilio (get these from https://console.twilio.com after signing up free) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Leave this as-is unless you set up your own WhatsApp sender:
TWILIO_WHATSAPP_NUMBER=whatsapp

# --- LLM provider: "groq" (free, recommended) or "openai" (paid) ---
LLM_PROVIDER=groq

# Groq (get a free key at https://console.groq.com/keys — no card needed)
GROQ_API_KEY=

# Only needed if you switch LLM_PROVIDER to openai
OPENAI_API_KEY=

# Leave blank to use the default model for your chosen provider
LLM_MODEL=

# --- Server ---
# Update this every time you restart ngrok (the URL changes on the free plan)
BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

BUSINESS_INFO_PATH=business_info.json

# --- Booking rules (optional to change) ---
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=18
SLOT_MINUTES=30

DB_PATH=appointments.db
